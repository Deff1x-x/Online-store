{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Host": {
    "ShutdownTimeoutSeconds": 30
  },
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Name": "online_store",
    "User": "postgres",
    "ValidateOnStartup": true,
    "MaxPoolSize": 100,
    "MinPoolSize": 0,
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "ConnectionIdleLifetimeSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
