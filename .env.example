NODE_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=online_store
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Development-only values. Production requires unique secrets of at least 32 characters.
JWT_SECRET=development-only-jwt-secret-do-not-use-in-production
# Used by .NET OTP HMAC; must differ from JWT_SECRET. Optional for Node (in-memory OTP in development).
OTP_SECRET=development-only-otp-hmac-secret-do-not-use-in-production
# Legacy Node API port (npm run dev:node / Compose profile legacy only).
PORT=3000
# Comma-separated browser origins for Node. .NET uses Cors / appsettings.Development.json.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Default local product API is ASP.NET Core on :5000.
VITE_API_URL=http://localhost:5000/api
VITE_ENV=development
VITE_APP_NAME=KOZ
VITE_STORE_ID=11111111-1111-1111-1111-111111111111
