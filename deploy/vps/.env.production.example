# =============================================================================
# Koz VPS production environment template — NO REAL SECRETS
# Copy to deploy/vps/.env on the server:  cp .env.production.example .env
# Permissions: chmod 600 .env   &&   chown root:root .env   (or dedicated deploy user)
# .env is gitignored — never commit.
# Restart required after changing any variable below (containers recreate).
# =============================================================================

# --- Image / compose ---
KOZ_IMAGE_TAG=replace-with-git-sha

# --- Public hostnames (placeholders) ---
# API_HOSTNAME=api.example.com
# FRONTEND_ORIGIN=https://app.example.com

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
# Host:ShutdownTimeoutSeconds mirrored via env if needed:
Host__ShutdownTimeoutSeconds=30

# --- Database (external managed OR host Postgres OR compose profile postgres) ---
# If using compose profile postgres, set DATABASE_HOST=postgres
DATABASE_HOST=REPLACE_DB_HOST
DATABASE_PORT=5432
DATABASE_NAME=REPLACE_DB_NAME
DATABASE_USER=REPLACE_DB_USER
# Non-default password; never use "postgres" in Production.
DATABASE_PASSWORD=REPLACE_DB_PASSWORD_MIN_16_CHARS
DATABASE_MAX_POOL_SIZE=20
DATABASE_MIN_POOL_SIZE=0
DATABASE_CONNECTION_TIMEOUT_SECONDS=15
DATABASE_COMMAND_TIMEOUT_SECONDS=30
# Optional when using compose postgres profile:
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# --- Auth secrets (REQUIRED, distinct, >= 32 chars each) ---
# JWT_SECRET must differ from OTP_SECRET. Do not reuse Development secrets.
JWT_SECRET=REPLACE_JWT_SECRET_AT_LEAST_32_CHARS____________
OTP_SECRET=REPLACE_OTP_SECRET_AT_LEAST_32_CHARS____________

# --- CORS: exact browser origins (scheme+host[+port], no trailing slash, no *) ---
Cors__AllowedOrigins__0=https://app.example.com
# Cors__AllowedOrigins__1=https://staff.example.com

# --- Trusted proxy (Docker internal bridge / Nginx container network) ---
# Only these sources may set X-Forwarded-*. Never leave empty in Production when Enabled=true.
ForwardedHeaders__Enabled=true
# Example private ranges — replace with your Compose network CIDR after `docker network inspect`.
ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
ForwardedHeaders__KnownNetworks__1=172.16.0.0/12
ForwardedHeaders__KnownNetworks__2=192.168.0.0/16
# Optional single-proxy IPs:
# ForwardedHeaders__KnownProxies__0=172.18.0.4

# --- Payments (launch decision: DISABLED) ---
PAYMENTS_ONLINE_INITIATION_ENABLED=false

# --- Node rollback (same DB credentials; Node does not use OTP_SECRET) ---
NODE_ENV=production
PORT=3000
# JWT_SECRET and DATABASE_* above are shared with Node for session compatibility.
